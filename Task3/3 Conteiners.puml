@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Диаграмма контейнеров MVP "Онлайн-открытие депозитов"

Person(Клиент, "Клиент банка", "Физ. лицо, открывающее депозит через сайт или интернет-банк")

System_Boundary(Клиентские_интерфейсы, "Пользовательские интерфейсы") {
    Container(Сайт, "Сайт банка", "PHP, React", "Позволяет клиенту подать заявку на депозит")
    Container(Интернет_банк, "Интернет-банк", "ASP.NET MVC, MS SQL", "Поддерживает полный цикл онлайн-открытия депозита")
}

System_Boundary(Бэкенд_сервисы, "Бэкенд-сервисы") {
    Container(Промежуточный_сервис, "Промежуточный сервис", "Java Spring Boot", "Интеграционный адаптер между интернет-банком и АБС")
    ContainerDb(Справочник_ставок, "Справочник ставок", "Oracle Database", "Хранит актуальные процентные ставки по депозитам")
    Container(Колл_центр, "Система колл-центра", "C#, WCF", "Обрабатывает входящие заявки от клиентов")
}

System_Boundary(Банковские_системы, "Корпоративные системы банка") {
    Container(АБС, "Автоматизированная банковская система", "Delphi, Oracle, PL-SQL", "Основная банковская система для обработки операций")
    Container(СМС_шлюз, "СМС-шлюз", "Java EE", "Отправка SMS-уведомлений клиентам")
}

Rel(Клиент, Сайт, "Подает заявку", "HTTPS")
Rel(Клиент, Интернет_банк, "Открывает депозит", "HTTPS")
Rel(Сайт, Колл_центр, "Передает заявку", "REST/JSON")
Rel(Интернет_банк, Промежуточный_сервис, "Отправляет данные депозита", "REST/JSON")
Rel(Промежуточный_сервис, Справочник_ставок, "Получает ставки", "JDBC")
Rel(Промежуточный_сервис, АБС, "Создает заявку на депозит", "SOAP")
Rel(АБС, СМС_шлюз, "Инициирует отправку уведомления", "JMS")
Rel(СМС_шлюз, Клиент, "Отправляет SMS", "SMPP")

@enduml
