@startuml context diagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Диаграмма контекста MVP "Онлайн-открытие депозитов"

Person(Клиент, "Клиент банка", "Пользователь сайта или интернет-банка, заинтересованный в открытии депозита")

System_Boundary(Платформа_банка, "Платформа банка") {
    System(Сайт, "Сайт банка", "PHP, React\nПоказывает список депозитов, позволяет подать заявку с Ф.И.О. и телефоном")
    System(Интернет_банк, "Интернет-банк", "ASP.NET MVC, MS SQL\nПозволяет выбрать сумму, счёт, подтвердить операцию СМС")
    System(Промежуточный_сервис, "Промежуточный сервис", "Java Spring Boot\nАдаптер между интернет-банком и АБС, рассчитывает ставки")
    System(АБС, "АБС", "Delphi, Oracle, PL-SQL\nОсновная банковская система. Обработка заявок сотрудниками бэк-офиса")
    System(Справочник_ставок, "Справочник ставок", "Хранилище актуальных ставок, обновляется ежедневно")
    System(СМС_шлюз, "СМС-шлюз", "Внутренняя система банка для отправки уведомлений")
}

Rel(Клиент, Сайт, "Подача заявки на открытие депозита", "HTTPS")
Rel(Клиент, Интернет_банк, "Онлайн открытие депозита", "HTTPS")

Rel(Сайт, Промежуточный_сервис, "Передает заявку", "SOAP")
Rel(Интернет_банк, Промежуточный_сервис, "Отправляет заявку на депозит", "REST/JSON")
Rel(Промежуточный_сервис, АБС, "Передает заявку на обработку", "JDBC")
Rel(Промежуточный_сервис, Справочник_ставок, "Получает процентную ставку", "SQL")
Rel(АБС, СМС_шлюз, "Отправляет уведомление", "SOAP")
Rel(СМС_шлюз, Клиент, "Отправляет СМС-сообщение", "SMPP")

@enduml
