@startuml context diagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Контекстная диаграмма "Передача ставок в кол-центр"

Person(Клиент, "Клиент банка", "Физическое лицо, интересующееся условиями депозитов")
Person(Оператор_банка, "Оператор кол-центра", "Внутренний сотрудник банка, консультирующий клиентов")
Person_Ext(Оператор_партнера, "Оператор партнера", "Внешний сотрудник компании-партнера")

System_Boundary(Банковские_системы, "Банковская платформа") {
    System(Кол_центр, "Система кол-центра", "Обработка входящих запросов, CRM-функционал")
    System(Справочник_ставок, "Справочник ставок", "Централизованное хранилище актуальных депозитных ставок")
}

System(Файловый_сервер, "Файловый сервер", "Сервер для обмена данными с партнерами (SFTP)")
System_Ext(Партнерский_колцентр, "Кол-центр партнера", "CRM-система для обработки клиентских запросов")

Rel(Клиент, Кол_центр, "Консультируется по условиям депозитов", "Телефонный звонок")
Rel(Клиент, Партнерский_колцентр, "Консультируется по условиям", "Телефонный звонок")

Rel(Оператор_банка, Кол_центр, "Работает с клиентскими запросами", "Web-интерфейс")
Rel(Оператор_партнера, Партнерский_колцентр, "Консультирует клиентов", "Локальное ПО")

Rel(Кол_центр, Справочник_ставок, "Запрашивает актуальные ставки", "REST API")

Rel(Справочник_ставок, Файловый_сервер, "Выгружает ставки для партнеров", "SFTP")
Rel(Файловый_сервер, Партнерский_колцентр, "Предоставляет файлы со ставками", "SFTP")

@enduml
